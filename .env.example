# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Secret Santa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# UI language: pt_BR (default), en or es. Fallback is English.
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database: PostgreSQL everywhere
# ---------------------------------------------------------------------------
# Local: `docker compose up -d pgsql mailpit` starts Postgres on port 5442
# (5442 avoids clashing with a Postgres already installed on 5432).
# Inside Sail containers use DB_HOST=pgsql and DB_PORT=5432 instead.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5442
DB_DATABASE=santa_secret
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=5442

# Production (Neon): set DB_URL and it takes precedence over the values above.
# DB_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Sessions, cache, queue: no Redis, no workers (free hosting friendly)
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS).
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# "log" writes emails to the log; the app works fully without email, and
# sign-in codes are only offered when a real mailer is configured.
# Local with Mailpit (http://localhost:8025): MAIL_MAILER=smtp, MAIL_HOST=127.0.0.1, MAIL_PORT=1025
# Production on Render's free plan (SMTP ports are blocked): MAIL_MAILER=resend + RESEND_API_KEY
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# Force e-mailed sign-in codes on/off. Empty = on whenever MAIL_MAILER is not log/array.
LOGIN_CODE_ENABLED=

# ---------------------------------------------------------------------------
# Google sign-in (optional; the button is hidden until both are set)
# ---------------------------------------------------------------------------
# Authorized redirect URI in Google Cloud: ${APP_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

VITE_APP_NAME="${APP_NAME}"
